---
import type { Template } from '../lib/types';

interface Props {
  template: Template;
  size?: 'card' | 'detail';
}

const { template, size = 'card' } = Astro.props;
const { primary, secondary, accent } = template.colorPalette;
const w = size === 'detail' ? 1200 : 600;
const h = size === 'detail' ? 675 : 338;

const titleSize = size === 'detail' ? 64 : 32;
const tagSize = size === 'detail' ? 22 : 12;
const padding = size === 'detail' ? 80 : 32;

const isDarkPrimary = parseInt(primary.slice(1, 3), 16) + parseInt(primary.slice(3, 5), 16) + parseInt(primary.slice(5, 7), 16) < 384;
const textOnPrimary = isDarkPrimary ? secondary : '#0a0a0a';
---
<svg viewBox={`0 0 ${w} ${h}`} xmlns="http://www.w3.org/2000/svg" class="block w-full h-auto">
  <rect width={w} height={h} fill={primary} />
  <rect x={padding} y={padding} width={w * 0.5 - padding} height="2" fill={accent} />
  <text x={padding} y={padding + titleSize + 8} fill={textOnPrimary}
    font-family="ui-serif, Georgia, serif" font-size={titleSize} font-weight="600">{template.style}</text>
  <text x={padding} y={padding + titleSize * 2 + 16} fill={accent}
    font-family="ui-monospace, monospace" font-size={tagSize} letter-spacing="0.15em">/ {template.useCase.toUpperCase()}</text>
  <rect x={w - padding - 80} y={h - padding - 8} width="40" height="2" fill={accent} />
  <rect x={padding} y={h - padding - 60} width={w * 0.35} height="40" fill={secondary} opacity="0.18" />
</svg>
