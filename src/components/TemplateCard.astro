---
import type { Template } from '../lib/types';
import { STYLE_LABEL, USE_CASE_LABEL } from '../lib/types';
import StyleTag from './StyleTag.astro';
import PreviewPlaceholder from './PreviewPlaceholder.astro';

interface Props { template: Template }
const { template } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const href = `${baseUrl}template/${template.slug}/`;
---
<a href={href} class="group block border border-[var(--color-border)] rounded-lg overflow-hidden bg-[#0e0e0e] hover:border-[var(--color-accent)]/60 hover:-translate-y-0.5 transition-all duration-200">
  <div class="aspect-video overflow-hidden border-b border-[var(--color-border)]">
    <PreviewPlaceholder template={template} />
  </div>
  <div class="p-5 space-y-3">
    <h3 class="font-serif text-lg leading-tight text-[var(--color-fg)] group-hover:text-[var(--color-accent)] transition-colors">{template.title}</h3>
    <p class="text-sm text-[var(--color-muted)] line-clamp-2">{template.description}</p>
    <div class="flex flex-wrap gap-1.5 pt-1">
      <StyleTag label={STYLE_LABEL[template.style]} variant="style" />
      <StyleTag label={USE_CASE_LABEL[template.useCase]} variant="use" />
    </div>
  </div>
</a>
