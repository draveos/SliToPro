---
import Base from '../../layouts/Base.astro';
import StyleTag from '../../components/StyleTag.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import TemplateInteractive from '../../components/TemplateInteractive.tsx';
import { templates, palettes, relatedTemplates } from '../../lib/loadTemplates';
import { CATEGORY_LABEL } from '../../lib/types';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return templates.map((t) => ({ params: { slug: t.slug }, props: { template: t } }));
}

const { template } = Astro.props;
const related = relatedTemplates(template);
---
<Base title={template.title} description={template.description}>
  <section class="max-w-5xl mx-auto px-6 pt-12 pb-8">
    <a href={url()} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors">← Gallery</a>
    <div class="mt-6 space-y-3 max-w-2xl">
      <div class="flex flex-wrap gap-2">
        <StyleTag label={CATEGORY_LABEL[template.category]} variant="style" />
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl leading-tight tracking-tight">{template.title}</h1>
      <p class="text-lg text-[var(--color-muted)] leading-relaxed">{template.description}</p>
      <p class="text-sm text-[var(--color-fg)]/80 leading-relaxed pt-2 italic">{template.philosophy}</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-16">
    <TemplateInteractive template={template} palettes={palettes} client:load />
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-16 grid gap-10 sm:grid-cols-2">
    <div>
      <h3 class="text-xs uppercase tracking-wider text-[var(--color-accent)] mb-2">Good for</h3>
      <ul class="space-y-1 text-sm">{template.goodFor.map((g) => <li>· {g}</li>)}</ul>
    </div>
    <div>
      <h3 class="text-xs uppercase tracking-wider text-[var(--color-muted)] mb-2">Avoid for</h3>
      <ul class="space-y-1 text-sm text-[var(--color-muted)]">{template.avoidFor.map((a) => <li>· {a}</li>)}</ul>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-16">
    <h3 class="text-xs uppercase tracking-wider text-[var(--color-muted)] mb-2">Tags</h3>
    <div class="flex flex-wrap gap-1.5">
      {template.tags.map((t) => <span class="text-xs font-mono text-[var(--color-muted)]">#{t}</span>)}
    </div>
  </section>

  {related.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pb-24">
      <h2 class="font-serif text-2xl mb-6">More in {CATEGORY_LABEL[template.category]}</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((t) => <TemplateCard template={t} />)}
      </div>
    </section>
  )}
</Base>
